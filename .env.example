# Copy to .env and fill in values. Never commit .env or firebase-service-account.json.

# Firebase — required for student FCM push (admin web uses SSE, not these)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
# PEM as one line with \n, or base64-encoded PEM (see firebase.config.ts fixPrivateKey)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=

# Google Sign-In (OAuth client IDs — NOT the Firebase service account private key)
GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com

# Cloudinary (API secret stays on server only)
CLOUDINARY_CLOUD_NAME=do0mrgzng
CLOUDINARY_API_KEY=333861776376889
CLOUDINARY_API_SECRET=PGnpzXd-SoDTeZ8jnUMDPwZVlnQ


